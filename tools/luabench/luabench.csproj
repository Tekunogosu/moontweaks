<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>moontweaks-luabench</AssemblyName>
    <RootNamespace>MoonTweaks.LuaBench</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Server GC changes what an allocation costs, and the game's server does not
         use it, so the figures are taken under the collector the mod runs under. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../moontweaks.csproj" />
  </ItemGroup>

  <!-- The scripting layer needs none of these, but the assembly it lives in is
       compiled against them, so they have to be here to load it. -->
  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VintageStoryDir)/VintagestoryAPI.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="VintagestoryLib"><HintPath>$(VintageStoryDir)/VintagestoryLib.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VintageStoryDir)/Lib/Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>

</Project>
