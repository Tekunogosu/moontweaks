<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>moontweaks</AssemblyName>
    <RootNamespace>MoonTweaks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A library does not copy its package assemblies out by default, and Lua.dll
         has to be beside moontweaks.dll for the zip to pick it up. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Vendored MoonSharp doc comments are incomplete and malformed in places.
         Documentation of our own bindings is enforced by the docs script in check mode. -->
    <NoWarn>$(NoWarn);CS1570;CS1571;CS1572;CS1573;CS1574;CS1591;CS0419</NoWarn>
  </PropertyGroup>

  <!-- Vintage Story install; override with the VINTAGE_STORY environment variable. -->
  <PropertyGroup>
    <VintageStoryDir Condition="'$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryDir>
    <VintageStoryDir Condition="'$(VintageStoryDir)' == ''">$(HOME)/.local/share/vintagestory</VintageStoryDir>
  </PropertyGroup>

  <!-- MoonSharp is compiled into moontweaks.dll rather than shipped beside it. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);DOTNET_CORE;HASDYNAMIC</DefineConstants>
    <MoonSharpDir>$(MSBuildThisFileDirectory)third_party/moonsharp/src/MoonSharp.Interpreter</MoonSharpDir>
  </PropertyGroup>

  <!-- The library is produced by ./scripts/docs.sh from a prior build, so a plain
       `dotnet build` may not have one yet; the mod reports its absence at startup. -->
  <ItemGroup>
    <EmbeddedResource Include="src/Host/Resources/luarc.json" LogicalName="MoonTweaks.luarc.json" />
    <EmbeddedResource Include="src/Host/Resources/vscode-extensions.json" LogicalName="MoonTweaks.vscode.extensions.json" />
    <EmbeddedResource Include="docs/library/moontweaks.lua" LogicalName="MoonTweaks.library.moontweaks.lua"
                      Condition="Exists('$(MSBuildThisFileDirectory)docs/library/moontweaks.lua')" />
    <!-- Shipped for authors to copy from, so every example is one the build checks. -->
    <EmbeddedResource Include="examples/scripts/*.lua" LogicalName="MoonTweaks.examples.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Lua-CSharp is a second interpreter, selectable from config.json and measured
       against MoonSharp by scripts/bench.sh. Unlike MoonSharp it is a package rather
       than vendored sources, so Lua.dll travels beside the mod in the zip. -->
  <ItemGroup>
    <PackageReference Include="LuaCSharp" Version="0.5.6" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Compile Include="$(MoonSharpDir)/**/*.cs" Link="third_party/MoonSharp/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VintageStoryDir)/VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VintagestoryLib"><HintPath>$(VintageStoryDir)/VintagestoryLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VintageStoryDir)/Lib/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(VintageStoryDir)/Lib/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSSurvivalMod"><HintPath>$(VintageStoryDir)/Mods/VSSurvivalMod.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSEssentials"><HintPath>$(VintageStoryDir)/Mods/VSEssentials.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
